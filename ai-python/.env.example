# ----------------------------------------------------------------------------
# Math Wise — AI service environment template.
# Copy this file to `.env` (same directory) and fill in real values.
# DO NOT commit `.env` itself — only this template.
# ----------------------------------------------------------------------------

# Selects which AI backend to use. One of: local | cloud
AI_MODE=local

# --- Local Ollama settings (used when AI_MODE=local) -----------------------
MODEL_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3.1

# --- Cloud API settings (used when AI_MODE=cloud) --------------------------
# Leave blank if you only run the local model.
CLOUD_API_KEY=
CLOUD_API_URI=

# --- Logging ---------------------------------------------------------------
# Standard Python logging level. One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO