# ----------------------------------------------------------------------------
# Math Wise — AI service environment template.
# Copy this file to `.env` (same directory) and fill in real values.
# DO NOT commit `.env` itself — only this template.
# ----------------------------------------------------------------------------

# Selects which AI backend to use. One of: local | cloud
# - local:  routes prompts to a locally running Ollama instance
# - cloud:  routes prompts to a hosted OpenAI-compatible API
AI_MODE=local

# --- Local Ollama settings (used when AI_MODE=local) -----------------------
# MODEL_URL is the base URL of the Ollama HTTP server. The adapter appends
# `/api/generate` internally — do NOT include the path here.
MODEL_URL=http://localhost:11434
MODEL_NAME=llama3.2:3b

# --- Cloud API settings (used when AI_MODE=cloud) --------------------------
# Both must be set when AI_MODE=cloud or the adapter will fail at startup.
CLOUD_API_KEY=
CLOUD_API_URI=
