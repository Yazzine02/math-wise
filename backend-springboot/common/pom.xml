<?xml version="1.0" encoding="UTF-8"?>
<!--
  common — the shared kernel of the MathWise services.

  Contains: JPA entities, Spring Data repositories, wire DTOs, the uniform
  error envelope (GlobalExceptionHandler + domain exceptions), and the JWT
  primitives (JwtUtil, JwtAuthFilter) that every protected service reuses.

  This is a PLAIN JAR: it does not declare the spring-boot-maven-plugin, so
  it is never repackaged into an executable boot jar — services depend on it
  like any library. With the shared-database topology (phase 12, step 1 of
  the migration), sharing the entity/repository layer is deliberate; when a
  service later gets its own database, its slice of this module moves into
  that service and out of here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mathwise</groupId>
        <artifactId>mathwise-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common</artifactId>
    <name>mathwise-common</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- OncePerRequestFilter, @RestControllerAdvice, servlet API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- jakarta.validation annotations on the request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
