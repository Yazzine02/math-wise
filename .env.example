# =============================================================================
# Math-Wise — environment template
#
# Copy this file to `.env` (in the same directory) and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. `.env.example` is committed and serves as the
# documented contract — every variable the project understands should appear
# here, with a sane default or an obvious placeholder.
# =============================================================================

# -------- Database (PostgreSQL) --------
# Hostname is "localhost" when Spring Boot runs on the host and connects to
# the Dockerised Postgres via published port. If you ever run Spring Boot
# inside Docker, set this to "postgres" (the service name).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mathwise_db
DB_USER=db_user
DB_PASSWORD=change_me_in_env

# -------- JWT signing key --------
# Must be ≥ 32 ASCII chars (256 bits) for HMAC-SHA256. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# -------- AI service (FastAPI) --------
# Spring Boot → FastAPI endpoint. When both run on the host: localhost:8000.
AI_SERVICE_URL=http://localhost:8000

# -------- AI service internals (FastAPI → Ollama) --------
# AI_MODE: "local" routes to Ollama; "cloud" routes to a remote API.
AI_MODE=local
# Inside docker compose: http://ollama:11434
# On the host directly:   http://localhost:11434
MODEL_URL=http://ollama:11434
MODEL_NAME=llama3.2:3b

# -------- PGAdmin (optional development DB GUI) --------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_in_env

# -------- Flutter (--dart-define) --------
# Android emulator: http://10.0.2.2:9090
# iOS simulator:    http://localhost:9090
# Physical device:  http://<your-machine-LAN-IP>:9090
API_BASE_URL=http://10.0.2.2:9090
